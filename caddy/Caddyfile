{
	# Global options
	admin 0.0.0.0:2019
}

# Main Homelab Dashboard (Homepage)
# Accepts apex domain or homelab/homepage subdomains (e.g. homelab.iye.internal or iye.internal)
{$DOMAIN:homelab.local}, homelab.{$DOMAIN:homelab.local}, homepage.{$DOMAIN:homelab.local} {
	tls internal
	reverse_proxy homepage:3000
}

# LibreNMS Web UI
librenms.{$DOMAIN:homelab.local} {
	tls internal
	reverse_proxy librenms:8000 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}
}

# Grafana Dashboards
grafana.{$DOMAIN:homelab.local} {
	tls internal
	reverse_proxy grafana:3000
}

# Prometheus Web UI & Metrics
prometheus.{$DOMAIN:homelab.local} {
	tls internal
	reverse_proxy prometheus:9090
}

# Oxidized Web UI & REST
oxidized.{$DOMAIN:homelab.local} {
	tls internal
	reverse_proxy oxidized:8888
}

# Trivy Security Scanner API
trivy.{$DOMAIN:homelab.local} {
	tls internal
	reverse_proxy trivy:4954
}

# NetBox IPAM & DCIM
netbox.{$DOMAIN:homelab.local} {
	tls internal
	reverse_proxy netbox:8080
}

# Ansible Semaphore Automation Web UI
semaphore.{$DOMAIN:homelab.local} {
	tls internal
	reverse_proxy semaphore:3000
}

# HomeGlow Smart Home & Family Dashboard
homeglow.{$DOMAIN:homelab.local} {
	tls internal
	reverse_proxy homeglow-frontend:3000
}
