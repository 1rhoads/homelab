# =====================================================================
# Homelab Portainer Stack Environment Variables
# =====================================================================

# Global System Settings
TZ=UTC
PUID=1000
PGID=1000

# Base Domain for Caddy Reverse Proxy
# Access services via:
#   Homepage:   https://${DOMAIN} or https://homelab.${DOMAIN}
#   LibreNMS:   https://librenms.${DOMAIN}
#   Grafana:    https://grafana.${DOMAIN}
#   Prometheus: https://prometheus.${DOMAIN}
#   Oxidized:   https://oxidized.${DOMAIN}
#   Trivy:      https://trivy.${DOMAIN}
DOMAIN=iye.internal

# Allowed hosts for Homepage dashboard (comma-separated or * to allow all)
HOMEPAGE_ALLOWED_HOSTS=*

# ---------------------------------------------------------------------
# Homelab Hostnames or IP Addresses
# You can use full DNS names (e.g. pve1.iye.internal) or static IPs!
# ---------------------------------------------------------------------
# Proxmox VE Hypervisor Nodes
PROXMOX_NODE1_HOST=pve1.iye.internal
PROXMOX_NODE2_HOST=pve2.iye.internal
PROXMOX_NODE3_HOST=pve3.iye.internal
PORTAINER_HOST=portainer.iye.internal

# MikroTik Switches
MIKROTIK_CORE_HOST=sw-core.iye.internal
MIKROTIK_SW2_HOST=sw-poe.iye.internal

# OpenWrt Access Points
OPENWRT_AP1_HOST=ap-livingroom.iye.internal
OPENWRT_AP2_HOST=ap-office.iye.internal

# ---------------------------------------------------------------------
# Database (MariaDB for LibreNMS)
# ---------------------------------------------------------------------
MYSQL_DATABASE=librenms
MYSQL_USER=librenms
MYSQL_PASSWORD=change_this_librenms_db_password

# ---------------------------------------------------------------------
# LibreNMS Configuration
# ---------------------------------------------------------------------
LIBRENMS_SNMP_COMMUNITY=homelab
LIBRENMS_BASE_URL=/

# Port exposure (Syslog and SNMP Trap ingestion)
SYSLOG_PORT=514
SNMPTRAP_PORT=162

# ---------------------------------------------------------------------
# Oxidized Automated Config Backups
# ---------------------------------------------------------------------
OXIDIZED_GLOBAL_USER=admin
OXIDIZED_GLOBAL_PASSWORD=changeme
OXIDIZED_ROUTEROS_USER=admin
OXIDIZED_ROUTEROS_PASSWORD=changeme
OXIDIZED_OPENWRT_USER=root
OXIDIZED_OPENWRT_PASSWORD=changeme
OXIDIZED_SOURCE=http
LIBRENMS_API_TOKEN=REPLACE_WITH_LIBRENMS_API_TOKEN

# ---------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------
# Trivy Vulnerability Scanner
# ---------------------------------------------------------------------
TRIVY_DEBUG=false
# TRIVY_TOKEN=optional_secret_token

# ---------------------------------------------------------------------
# Ansible Semaphore
# ---------------------------------------------------------------------
SEMAPHORE_ADMIN_USER=admin
SEMAPHORE_ADMIN_PASSWORD=change_this_semaphore_password
# Encrypts stored SSH keys in the Semaphore DB. Generate with: head -c32 /dev/urandom | base64
# Changing it makes existing stored keys unreadable; re-enter them in the UI afterwards.
SEMAPHORE_ACCESS_KEY_ENCRYPTION=REPLACE_WITH_RANDOM_BASE64_32_BYTES
# Used by ansible/inventory/netbox.yml
NETBOX_TOKEN=REPLACE_WITH_NETBOX_API_TOKEN

# ---------------------------------------------------------------------
# SMTP Outbound Email (msmtpd for LibreNMS alerts)
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=on
SMTP_STARTTLS=on
SMTP_TLS_CHECKCERT=on
SMTP_AUTH=on
SMTP_USER=user@example.com
SMTP_PASSWORD=secretpassword
SMTP_FROM=homelab-alerts@example.com
