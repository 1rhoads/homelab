        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "severity 1": true,
              "severity 2": true,
              "severity 3": true,
              "severity 4": true
            },
            "indexByName": {},
            "renameByName": {
              "Value #Critical": "Critical",
              "Value #High": "High",
              "Value #Low": "Low",
              "Value #Medium": "Medium",
              "Value #Status": "Status",
              "container": "Container",
              "image": "Image"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
