                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Fixed Version" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#73BF69", "value": null }
                  ]
