          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "match": "exact", "result": { "color": "#F2495C", "text": "CRITICAL" } }, "type": "value" },
                  { "options": { "match": "exact", "result": { "color": "#FF9830", "text": "HIGH" } }, "type": "value" },
                  { "options": { "match": "exact", "result": { "color": "#FADE2A", "text": "MEDIUM" } }, "type": "value" },
                  { "options": { "match": "exact", "result": { "color": "#5794F2", "text": "LOW" } }, "type": "value" }
