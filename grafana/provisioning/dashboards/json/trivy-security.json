          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Vulnerability Findings (CVE, Affected Package & Fix)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "role": true,
              "service": true
            },
            "indexByName": {},
            "renameByName": {
              "container": "Container",
              "cve_id": "CVE ID",
              "fixed_version": "Fixed Version",
              "image": "Image",
              "installed_version": "Installed Version",
              "package": "Package",
              "severity": "Severity",
              "title": "Description / Advisory"
            }
          }
        }
      ],
      "type": "table"
